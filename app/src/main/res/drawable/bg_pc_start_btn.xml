<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#3A3A4A" />
                    <stroke android:width="1dp" android:color="#55FFFFFF" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#2A2A3A" />
                    <stroke android:width="1dp" android:color="#33FFFFFF" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#333344" />
                    <stroke android:width="1.5dp" android:color="#FF4FA7FA" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#22FFFFFF" />
                    <stroke android:width="0.5dp" android:color="#18FFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
