<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#404FA7FA">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#384FA7FA" />
                    <stroke android:width="1.5dp" android:color="#4FA7FA" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#504FA7FA" />
                    <stroke android:width="1.5dp" android:color="#4FA7FA" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#283242" />
                    <stroke android:width="1dp" android:color="#4A5E78" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#1A222E" />
                    <stroke android:width="1dp" android:color="#2D3A4C" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
