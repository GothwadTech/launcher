<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="#35465C" />
            <stroke android:width="1.5dp" android:color="#4FA7FA" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="#2C3B4E" />
            <stroke android:width="1dp" android:color="#4FA7FA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="#1A222E" />
            <stroke android:width="1dp" android:color="#283546" />
        </shape>
    </item>
</selector>
