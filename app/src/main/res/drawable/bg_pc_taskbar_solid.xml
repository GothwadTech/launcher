<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid Taskbar Surface (#202124 in dark, #F8F9FA in light) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pc_taskbar_bg" />
        </shape>
    </item>
    <!-- Crisp Top Border Highlight (#303134 in dark, #DADCE0 in light) -->
    <item android:bottom="0dp" android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="@color/pc_taskbar_border" />
        </shape>
    </item>
</layer-list>
