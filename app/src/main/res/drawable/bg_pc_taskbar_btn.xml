<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#334FA7FA">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="#334FA7FA" />
                    <stroke android:width="1.5dp" android:color="#4FA7FA" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="#4D4FA7FA" />
                    <stroke android:width="1.5dp" android:color="#4FA7FA" />
                </shape>
            </item>
            <item android:state_hovered="true">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="#243040" />
                    <stroke android:width="1dp" android:color="#4A5E78" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="#141A24" />
                    <stroke android:width="1dp" android:color="#242E3E" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
