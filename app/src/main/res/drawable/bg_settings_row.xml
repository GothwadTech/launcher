<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: entire rectangle background subtly highlights, no rounded corners or stroke -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#243444" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#35485B" />
        </shape>
    </item>
    <!-- Selected state -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F3446" />
        </shape>
    </item>
    <!-- Default state: completely transparent, not a card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>

