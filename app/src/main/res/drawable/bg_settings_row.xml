<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: solid white highlight with curved corners like in screenshot -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E2E8F0" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!--
        Selected state: the accent cyan chip. This used to be the same solid white as the
        focused state, which made "chosen option" and "currently focused" indistinguishable -
        and combined with the old hard-coded white button text it made the focus highlight
        look like a blank white pill (white text on white background). Selected = cyan with
        dark text (color_settings_btn_text), focused = white with dark text.
    -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#4DD0E1" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Default state: sleek dark rounded pill container matching screenshot -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#28292E" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
