<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3338BDF8" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#9938BDF8" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D38BDF8" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2638BDF8" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#4D38BDF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
