<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181A20"
    android:orientation="vertical">

    <!-- Windows 11 Title Bar -->
    <LinearLayout
        android:id="@+id/win_titlebar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="#15171C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_win_personalisation"
            android:tint="#0078D4" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Settings"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <!-- Minimize -->
        <ImageButton
            android:id="@+id/btn_win_minimize"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_win_btn"
            android:contentDescription="Minimize"
            android:src="@drawable/bg_taskbar_active_indicator"
            android:tint="#CCCCCC" />

        <!-- Maximize -->
        <ImageButton
            android:id="@+id/btn_win_maximize"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_win_btn"
            android:contentDescription="Maximize"
            android:src="@drawable/bg_win_btn"
            android:tint="#CCCCCC" />

        <!-- Close -->
        <ImageButton
            android:id="@+id/btn_win_close"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_win_close_btn"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#242834" />

    <!-- Split Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Left Sidebar Navigation -->
        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:background="#15171D"
            android:orientation="vertical">

            <!-- Profile Info matching Screenshot 6 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_badge"
                    android:backgroundTint="#0078D4">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_win_accounts"
                        android:tint="#FFFFFF" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Local Account"
                        android:textColor="#8E95A5"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Search box: "Find a setting" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_win11_search_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    android:tint="#8E95A5" />

                <EditText
                    android:id="@+id/et_search_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="Find a setting"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666B79"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Navigation Tabs RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_settings_nav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#242834" />

        <!-- Right Content Area -->
        <FrameLayout
            android:id="@+id/container_settings_page"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#1B1E26" />
    </LinearLayout>
</LinearLayout>
