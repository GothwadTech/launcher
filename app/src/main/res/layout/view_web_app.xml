<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181B20"
    android:orientation="vertical">

    <!-- Top URL / Address Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#23272F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btn_web_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_win_btn"
            android:contentDescription="Back"
            android:padding="6dp" />

        <ImageButton
            android:id="@+id/btn_web_forward"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_win_btn"
            android:contentDescription="Forward"
            android:padding="6dp" />

        <ImageButton
            android:id="@+id/btn_web_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_win_btn"
            android:contentDescription="Refresh"
            android:padding="6dp" />

        <!-- Address Bar Input -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pc_taskbar_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/img_web_ssl_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/et_web_url"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Enter URL (e.g., https://google.com)"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#66FFFFFF"
                android:textSize="11.5sp" />

            <ImageButton
                android:id="@+id/btn_web_go"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_win_btn"
                android:contentDescription="Go"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Action: Pin as Desktop Shortcut / PWA App -->
        <ImageButton
            android:id="@+id/btn_pin_to_desktop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_win_btn"
            android:contentDescription="Pin App"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Web Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/web_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@drawable/bg_circle_badge"
        android:visibility="gone" />

    <!-- Web View Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Fallback/Offline State -->
        <LinearLayout
            android:id="@+id/layout_web_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/img_web_error"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_web_error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Cannot connect to page"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_web_error_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Please check internet connection or URL"
                android:textColor="#99FFFFFF"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btn_web_retry"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:text="Retry"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
