<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9000000"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_rounded"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Search Input Bar -->
        <LinearLayout
            android:id="@+id/container_search_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_dialog_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/img_search_status_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Search" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_apps_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#66FFFFFF"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btn_clear_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_dialog_button"
                android:contentDescription="Clear"
                android:padding="6dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_close_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dialog_button"
                android:contentDescription="Close"
                android:padding="6dp" />
        </LinearLayout>

        <!-- Secret Vault Banner (Visible when secret code matched) -->
        <LinearLayout
            android:id="@+id/banner_secret_vault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#26FFB300"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/img_vault_lock"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Secret Vault" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Secret Vault Unlocked: Showing Hidden Apps"
                android:textColor="#FFB300"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Search Results Grid / List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_search_results"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="12dp" />

        <!-- Empty state text -->
        <TextView
            android:id="@+id/tv_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="32dp"
            android:text="No apps found matching your search"
            android:textColor="#66FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</FrameLayout>
