<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_item_root"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/nav_active_indicator"
        android:layout_width="3.5dp"
        android:layout_height="18dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="3dp"
        android:background="@drawable/bg_circle_badge"
        android:backgroundTint="#0078D4"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/nav_item_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/nav_item_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:tint="#8E95A5" />

        <TextView
            android:id="@+id/nav_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#CCCCCC"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
