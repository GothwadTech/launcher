<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/window_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_floating_window"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:clipToOutline="true"
    android:elevation="12dp">

    <!-- Window Title Bar -->
    <RelativeLayout
        android:id="@+id/window_title_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#33000000"
        android:gravity="center_vertical">

        <!-- Window App Icon & Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/window_controls"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/img_window_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                tools:src="@drawable/ic_folder" />

            <TextView
                android:id="@+id/tv_window_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="File Manager" />
        </LinearLayout>

        <!-- Window Controls: Minimize, Maximize/Restore, Close -->
        <LinearLayout
            android:id="@+id/window_controls"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="4dp">

            <!-- Minimize Button -->
            <ImageView
                android:id="@+id/btn_win_minimize"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_win_btn"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Minimize" />

            <!-- Maximize / Restore Button -->
            <ImageView
                android:id="@+id/btn_win_maximize"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_win_btn"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Maximize or Restore" />

            <!-- Close Button -->
            <ImageView
                android:id="@+id/btn_win_close"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_win_close_btn"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Close" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Window Content Frame -->
    <FrameLayout
        android:id="@+id/window_content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true" />

</LinearLayout>
