<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pc_context_menu_pro"
    android:elevation="20dp"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Header - Desktop -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_pc_menu_header">

        <ImageView
            android:id="@+id/img_menu_header_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desktop"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Right-click menu"
                android:textColor="#88FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:layout_marginHorizontal="8dp"
        android:background="#15FFFFFF" />

    <!-- View Submenu -->
    <LinearLayout
        android:id="@+id/item_view"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_view"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="View" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="View"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/img_arrow_view"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="More" />
    </LinearLayout>

    <!-- Sort by -->
    <LinearLayout
        android:id="@+id/item_sort_desktop"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_sort"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Sort" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Sort by"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_current_sort_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1A4FA7FA"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Custom"
            android:textColor="#8AB4F8"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/img_arrow_sort"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:contentDescription="More" />
    </LinearLayout>

    <!-- Refresh -->
    <LinearLayout
        android:id="@+id/item_refresh_desktop"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_refresh"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Refresh" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Refresh"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#15FFFFFF"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="F5"
            android:textColor="#88FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:layout_marginHorizontal="8dp"
        android:background="#12FFFFFF" />

    <!-- New -->
    <LinearLayout
        android:id="@+id/item_new"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_new"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="New" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="New"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/img_arrow_new"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="More" />
    </LinearLayout>

    <!-- File Manager -->
    <LinearLayout
        android:id="@+id/item_file_manager"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_file_manager"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="File Manager" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="File Manager"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Open Terminal -->
    <LinearLayout
        android:id="@+id/item_terminal"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_terminal"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Terminal" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Open in Terminal"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:layout_marginHorizontal="8dp"
        android:background="#12FFFFFF" />

    <!-- Display Settings Group -->
    <LinearLayout
        android:id="@+id/item_pc_ui_scale"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_scale"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Scale" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Display Scale"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_current_scale_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1A4FA7FA"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="85%"
            android:textColor="#4FA7FA"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/img_arrow_scale"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:contentDescription="More" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_icon_size"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_size"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Icon Size" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Icon Size"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_current_icon_size_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#15FFFFFF"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Medium"
            android:textColor="#CCCCCC"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/img_arrow_icon_size"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:contentDescription="More" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_desktop_spacing"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_spacing"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Spacing" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Icon Spacing"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_current_spacing_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#15FFFFFF"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Normal"
            android:textColor="#CCCCCC"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_toggle_labels"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_labels"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Labels" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Show Labels"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/img_check_labels"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Check" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:layout_marginHorizontal="8dp"
        android:background="#12FFFFFF" />

    <!-- Taskbar & System -->
    <LinearLayout
        android:id="@+id/item_taskbar_settings"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_taskbar"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Taskbar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Taskbar Settings"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/img_arrow_taskbar"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="More" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_display_settings"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_display_settings"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Display" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Display Settings"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_personalize"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_pc_menu_item_pro"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_personalize"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Personalize" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Personalize"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:layout_marginHorizontal="8dp"
        android:background="#15FFFFFF" />

    <LinearLayout
        android:id="@+id/item_open_settings"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_pc_menu_item_pro_accent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_icon_settings"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Settings" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Launcher Settings"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
