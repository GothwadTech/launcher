<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1E26"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personalisation"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Top Preview Area matching Screenshots 12 & 13 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_win11_card"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Hero Wallpaper Preview Screen -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="130dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/img_hero_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Current Desktop Wallpaper"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                <!-- Miniature Desktop Overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom"
                    android:background="#CC111318" />
            </FrameLayout>

            <!-- Theme selection & Browse photos -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select a desktop wallpaper to apply"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_current_wallpaper_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Windows 11 Bloom"
                    android:textColor="#8E95A5"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_browse_custom_wallpaper"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Browse photos"
                        android:textSize="12sp"
                        app:cornerRadius="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reset_default_wallpaper"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:text="Reset to default"
                        android:textColor="#8E95A5"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Horizontal Wallpaper Thumbnails List (All 13 Wallpapers) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="Desktop Wallpapers (13 Presets)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_wallpapers"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- Accent Colors Section -->
        <LinearLayout
            android:id="@+id/container_accent_colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_win11_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accent colour"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Choose your Windows accent colour"
                android:textColor="#8E95A5"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layout_accent_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Settings Cards matching screenshot 12 -->
        <LinearLayout
            android:id="@+id/card_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_colours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_themes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_lock_screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_touch_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_taskbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_fonts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_device_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/item_pc_setting_card" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
