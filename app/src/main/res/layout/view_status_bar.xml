<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="40dp"
    android:paddingTop="18dp"
    android:paddingBottom="8dp">

    <!-- Left Cluster: Control Center, Search, Voice, BT, Notifications -->
    <LinearLayout
        android:id="@+id/cluster_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_glass_cluster"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <ImageButton
            android:id="@+id/btn_home"
            style="@style/Widget.LiteTV.StatusButton"
            android:contentDescription="@string/cd_home"
            android:padding="7dp" />

        <ImageButton
            android:id="@+id/btn_search"
            style="@style/Widget.LiteTV.StatusButton"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cd_search"
            android:padding="7dp" />

        <ImageButton
            android:id="@+id/btn_bluetooth"
            style="@style/Widget.LiteTV.StatusButton"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cd_bluetooth"
            android:padding="7dp"
            android:visibility="visible" />

        <!-- Notification Bell with Red Dot -->
        <FrameLayout
            android:id="@+id/layout_notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp">

            <ImageButton
                android:id="@+id/btn_notifications"
                style="@style/Widget.LiteTV.StatusButton"
                android:contentDescription="@string/cd_notifications"
                android:padding="7dp" />

            <!-- Red Dot when notifications present -->
            <View
                android:id="@+id/view_notification_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_status_icon_button"
                android:backgroundTint="@color/status_notification_badge"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <!-- Right Cluster: Active Media (when present), Wi-Fi, Settings, Date/Day/Time -->
    <LinearLayout
        android:id="@+id/cluster_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_glass_cluster"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <ImageButton
            android:id="@+id/btn_bg_media"
            style="@style/Widget.LiteTV.StatusButton"
            android:contentDescription="Background Media"
            android:padding="7dp"
            android:visibility="gone" />

        <!-- VPN shortcut: only visible while a VPN is actually active (Settings > Device
             Preferences > VPN shortcut). -->
        <ImageButton
            android:id="@+id/btn_vpn"
            style="@style/Widget.LiteTV.StatusButton"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cd_vpn"
            android:padding="7dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_network"
            style="@style/Widget.LiteTV.StatusButton"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cd_network"
            android:padding="7dp" />

        <ImageButton
            android:id="@+id/btn_settings"
            style="@style/Widget.LiteTV.StatusButton"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cd_settings"
            android:padding="7dp" />

        <View
            android:id="@+id/divider_clock"
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="10dp"
            android:background="@color/surface_glass_border" />

        <TextView
            android:id="@+id/tv_clock"
            style="@style/TextAppearance.LiteTV.Clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</RelativeLayout>
