<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pc_launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Wallpaper Layer -->
    <ImageView
        android:id="@+id/img_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Desktop Scrim -->
    <View
        android:id="@+id/view_desktop_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#20000000" />

    <!-- Desktop Icons Grid (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_desktop_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="44dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp" />

    <!-- Start Menu Container (Flyout above taskbar) -->
    <FrameLayout
        android:id="@+id/container_start_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="50dp"
        android:visibility="gone">

        <include
            android:id="@+id/view_start_menu"
            layout="@layout/layout_pc_start_menu" />
    </FrameLayout>

    <!-- Quick Settings Flyout Container (Flyout above system tray) -->
    <FrameLayout
        android:id="@+id/container_quick_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="50dp"
        android:visibility="gone">

        <include
            android:id="@+id/view_quick_settings"
            layout="@layout/layout_pc_quick_settings" />
    </FrameLayout>

    <!-- Bottom Taskbar -->
    <RelativeLayout
        android:id="@+id/layout_taskbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:background="#E616181E"
        android:paddingHorizontal="6dp">

        <!-- Top Border Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentTop="true"
            android:background="#26FFFFFF" />

        <!-- Left / Center Navigation Section (Start + Search + Pinned Apps) -->
        <LinearLayout
            android:id="@+id/layout_taskbar_apps"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_start"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:contentDescription="Start Menu"
                android:padding="6dp" />

            <!-- Windows / Linux style Taskbar Search Bar -->
            <LinearLayout
                android:id="@+id/btn_search"
                android:layout_width="140dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pc_taskbar_search_bar"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/img_taskbar_search_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Type here to search"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Pinned Apps List on Taskbar -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_taskbar_pinned"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- Right Side: Tray (Volume, WiFi, Battery, Notifications, Clock, Peek) -->
        <LinearLayout
            android:id="@+id/layout_taskbar_tray"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- System Quick Refresh Button in Taskbar -->
            <ImageButton
                android:id="@+id/btn_taskbar_refresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:contentDescription="System Refresh"
                android:padding="5dp" />

            <!-- Clickable Tray Cluster (Opens Quick Settings) -->
            <LinearLayout
                android:id="@+id/layout_tray_cluster"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:id="@+id/img_tray_network"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Network" />

                <ImageView
                    android:id="@+id/img_tray_volume"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Volume" />

                <ImageView
                    android:id="@+id/img_tray_battery"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Battery" />

                <TextView
                    android:id="@+id/tv_tray_battery_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textColor="#CCCCCC"
                    android:textSize="10sp"
                    tools:text="100%" />
            </LinearLayout>

            <!-- Notifications Button with Badge -->
            <FrameLayout
                android:id="@+id/btn_notifications_container"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageButton
                    android:id="@+id/btn_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:contentDescription="@string/notifications_title"
                    android:padding="6dp" />

                <TextView
                    android:id="@+id/tv_notif_badge"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_circle_badge"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Clock and Date Cluster -->
            <LinearLayout
                android:id="@+id/layout_clock_cluster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|end"
                android:orientation="vertical"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/tv_taskbar_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="12:00 PM" />

                <TextView
                    android:id="@+id/tv_taskbar_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#99FFFFFF"
                    android:textSize="8.5sp"
                    tools:text="09/15/2026" />
            </LinearLayout>

            <!-- Show Desktop Peek Button (Windows style edge strip) -->
            <View
                android:id="@+id/btn_show_desktop"
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:background="#26FFFFFF" />
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
