<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9000000"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_rounded"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_shield_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_dialog_button"
                android:padding="10dp"
                android:contentDescription="Shield" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_shield_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Background Audio Active"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_shield_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="An app is currently playing audio in background"
                    android:textColor="#A6FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Media Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_dialog_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_source_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Source: Unknown"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_media_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Title: Playing"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_package_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#66FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- 1. Silence Audio -->
            <Button
                android:id="@+id/btn_silence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dialog_button"
                android:minHeight="48dp"
                android:text="Silence Audio (Mute Ad)"
                android:textColor="#FF5252"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 2. Stop Player -->
            <Button
                android:id="@+id/btn_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dialog_button"
                android:minHeight="48dp"
                android:text="Stop Media Playback"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- 3. Kill Background Process -->
            <Button
                android:id="@+id/btn_kill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dialog_button"
                android:minHeight="48dp"
                android:text="Kill Background Process"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- 4. App Info -->
            <Button
                android:id="@+id/btn_app_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dialog_button"
                android:minHeight="48dp"
                android:text="Open App Settings / Force Stop"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- 5. Close -->
            <Button
                android:id="@+id/btn_close"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dialog_button"
                android:minHeight="48dp"
                android:text="Close"
                android:textColor="#A6FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
