<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_floating_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Outside Scrim / Dismiss touch barrier -->
    <View
        android:id="@+id/view_overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- Popup Options Panel (similar to desktop right-click context menu) -->
    <LinearLayout
        android:id="@+id/layout_overlay_menu"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/bg_pc_context_menu"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <!-- Panel Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_panel_header_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Quick Assist Controls"
                android:textColor="#4FA7FA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_close_menu"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:padding="3dp"
                android:contentDescription="Close" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="3dp"
            android:background="#20FFFFFF" />

        <!-- 1. Toggle Taskbar Visibility Option -->
        <LinearLayout
            android:id="@+id/item_menu_toggle_taskbar"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_toggle_taskbar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_toggle_taskbar_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Show Taskbar"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_taskbar_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pc_taskbar_search_bar"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Toggle"
                android:textColor="#4FA7FA"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 2. Home / Desktop Option -->
        <LinearLayout
            android:id="@+id/item_menu_home"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_home"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Go to Desktop"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 3. Open File Manager Window -->
        <LinearLayout
            android:id="@+id/item_menu_file_manager"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_file_mgr"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="File Manager"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 4. Open Web Browser Window -->
        <LinearLayout
            android:id="@+id/item_menu_web_app"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_web_app"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Web Browser"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="3dp"
            android:background="#20FFFFFF" />

        <!-- 5. Search Apps Option -->
        <LinearLayout
            android:id="@+id/item_menu_search"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_search"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Search Apps"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 6. Notifications Option -->
        <LinearLayout
            android:id="@+id/item_menu_notifications"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_notifs"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Notifications"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 7. Volume / Quick Settings Option -->
        <LinearLayout
            android:id="@+id/item_menu_volume"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_volume"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Volume / Quick Settings"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 8. Switch to TV Mode -->
        <LinearLayout
            android:id="@+id/item_menu_tv_mode"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_tv"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Switch to TV Mode"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 9. Settings Option -->
        <LinearLayout
            android:id="@+id/item_menu_settings"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_settings"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Launcher Settings"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Full Bottom Taskbar (System Alert Window Overlay) -->
    <RelativeLayout
        android:id="@+id/layout_overlay_taskbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_pc_taskbar_solid"
        android:elevation="14dp"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <!-- Left Navigation Section (Start + Search + Apps) -->
        <LinearLayout
            android:id="@+id/layout_taskbar_apps"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_overlay_start"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_pc_start_btn"
                android:contentDescription="Start Menu"
                android:padding="5dp"
                android:scaleType="fitCenter" />

            <!-- Search Bar -->
            <LinearLayout
                android:id="@+id/btn_overlay_search"
                android:layout_width="140dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pc_taskbar_search_bar"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:id="@+id/img_overlay_search_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Type to search"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Pinned Apps List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_overlay_pinned"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- Right Side: Tray (Volume, WiFi, Battery, Clock, Hide Taskbar Button) -->
        <LinearLayout
            android:id="@+id/layout_overlay_tray"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Clickable Tray Cluster -->
            <LinearLayout
                android:id="@+id/layout_overlay_tray_cluster"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:id="@+id/img_overlay_tray_network"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Network" />

                <ImageView
                    android:id="@+id/img_overlay_tray_volume"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Volume" />

                <ImageView
                    android:id="@+id/img_overlay_tray_battery"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="Battery" />

                <TextView
                    android:id="@+id/tv_overlay_tray_battery_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textColor="#CCCCCC"
                    android:textSize="10sp"
                    tools:text="100%" />
            </LinearLayout>

            <!-- Notifications Button -->
            <FrameLayout
                android:id="@+id/btn_overlay_notifications_container"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageButton
                    android:id="@+id/btn_overlay_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:contentDescription="Notifications"
                    android:padding="6dp" />
            </FrameLayout>

            <!-- Clock Cluster -->
            <LinearLayout
                android:id="@+id/layout_overlay_clock_cluster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|end"
                android:orientation="vertical"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/tv_overlay_taskbar_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="12:00 PM" />

                <TextView
                    android:id="@+id/tv_overlay_taskbar_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#99FFFFFF"
                    android:textSize="8.5sp"
                    tools:text="09/15/2026" />
            </LinearLayout>

            <!-- Hide Taskbar / Peek Button (Tap to hide taskbar back to floating bubble) -->
            <FrameLayout
                android:id="@+id/btn_hide_overlay_taskbar"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Hide Taskbar">

                <ImageView
                    android:id="@+id/img_hide_taskbar_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>

</FrameLayout>
