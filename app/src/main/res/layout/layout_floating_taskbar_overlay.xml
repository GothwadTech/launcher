<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_floating_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Outside Scrim / Dismiss touch barrier -->
    <View
        android:id="@+id/view_overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- Popup Options Panel (similar to desktop right-click context menu) -->
    <LinearLayout
        android:id="@+id/layout_overlay_menu"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/bg_pc_context_menu"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <!-- Panel Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_panel_header_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Quick Assist Controls"
                android:textColor="#4FA7FA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_close_menu"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:clickable="true"
                android:focusable="true"
                android:padding="3dp"
                android:contentDescription="Close" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="3dp"
            android:background="#20FFFFFF" />

        <!-- 1. Home / Desktop Option -->
        <LinearLayout
            android:id="@+id/item_menu_home"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_home"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Go to Desktop"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 2. Open File Manager Window -->
        <LinearLayout
            android:id="@+id/item_menu_file_manager"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_file_mgr"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="File Manager"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 3. Open Web Browser Window -->
        <LinearLayout
            android:id="@+id/item_menu_web_app"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_web_app"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Web Browser"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="3dp"
            android:background="#20FFFFFF" />

        <!-- 4. Search Apps Option -->
        <LinearLayout
            android:id="@+id/item_menu_search"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_search"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Search Apps"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 5. Notifications Option -->
        <LinearLayout
            android:id="@+id/item_menu_notifications"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_notifs"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Notifications"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 6. Volume / Quick Settings Option -->
        <LinearLayout
            android:id="@+id/item_menu_volume"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_volume"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Volume / Quick Settings"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 7. Switch to TV Mode -->
        <LinearLayout
            android:id="@+id/item_menu_tv_mode"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_tv"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Switch to TV Mode"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 8. Settings Option -->
        <LinearLayout
            android:id="@+id/item_menu_settings"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/img_icon_settings"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Launcher Settings"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
