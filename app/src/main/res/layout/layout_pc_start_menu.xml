<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_start_menu"
    android:layout_width="400dp"
    android:layout_height="480dp"
    android:background="@drawable/bg_pc_context_menu"
    android:elevation="24dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Search Bar in Start Menu -->
    <LinearLayout
        android:id="@+id/start_search_container"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_pc_desktop_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/img_start_search_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_start_search_placeholder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Type here to search apps..."
            android:textColor="#9AA0A6"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Pinned / Fast Launch Apps Section Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pinned Apps"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_all_apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="All Apps ›"
            android:textColor="#4FA7FA"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Start Menu Grid of Apps -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_start_menu_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadeScrollbars="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="#20FFFFFF" />

    <!-- Footer Bar: User Profile, TV Mode, Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_user_avatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="User" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Desktop"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_start_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_pc_taskbar_btn"
            android:contentDescription="System Refresh"
            android:padding="6dp" />

        <ImageButton
            android:id="@+id/btn_start_tv_mode"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_pc_taskbar_btn"
            android:contentDescription="Switch to TV Mode"
            android:padding="6dp" />

        <ImageButton
            android:id="@+id/btn_start_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_pc_taskbar_btn"
            android:contentDescription="Settings"
            android:padding="6dp" />
    </LinearLayout>

</LinearLayout>
