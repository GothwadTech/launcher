<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hidden Apps Search Reveal Code"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:text="Enter the secret keyword or code to type into the search bar to reveal hidden apps."
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/et_reveal_code"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_dialog_card"
        android:hint="e.g. #hidden, vault, secret"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_reveal_code"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_button"
            android:text="Cancel"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_save_reveal_code"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_dialog_button"
            android:text="Save Code"
            android:textColor="#4DD0E1" />
    </LinearLayout>

</LinearLayout>
