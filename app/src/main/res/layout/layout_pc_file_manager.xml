<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1C20"
    android:orientation="vertical">

    <!-- Title Bar - Windows Explorer Style -->
    <LinearLayout
        android:id="@+id/filemanager_titlebar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#FF232631"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/img_fm_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="File Manager" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="File Manager"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- View Mode Toggle -->
        <ImageView
            android:id="@+id/btn_view_mode"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_pc_window_btn"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp"
            android:contentDescription="View Mode" />

        <!-- New Folder -->
        <ImageView
            android:id="@+id/btn_new_folder"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_pc_window_btn"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp"
            android:contentDescription="New Folder" />

        <!-- Close -->
        <FrameLayout
            android:id="@+id/btn_fm_close"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_pc_window_btn_close"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/img_fm_close"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <!-- Navigation Bar - Address + Up/Back -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#FF1E2028"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <ImageView
            android:id="@+id/btn_nav_back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_pc_taskbar_btn"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:contentDescription="Back" />

        <ImageView
            android:id="@+id/btn_nav_up"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_pc_taskbar_btn"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:contentDescription="Up" />

        <ImageView
            android:id="@+id/btn_nav_home"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_pc_taskbar_btn"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:contentDescription="Home" />

        <TextView
            android:id="@+id/tv_current_path"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="#22FFFFFF"
            android:ellipsize="middle"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            tools:text="/storage/emulated/0/Download" />

        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pc_taskbar_btn"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <!-- Main Content: Sidebar + Files -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Sidebar - Quick Access / Storages -->
        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:background="#FF181A20"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:text="Quick Access"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_sidebar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#14FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tv_storage_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#66FFFFFF"
                    android:textSize="9sp"
                    tools:text="Free: 12.4 GB" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vertical Separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#14FFFFFF" />

        <!-- Files List -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_files"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="2dp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layout_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/img_empty_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:alpha="0.3" />

                <TextView
                    android:id="@+id/tv_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Folder is empty"
                    android:textColor="#88FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="No files here"
                    android:textColor="#55FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:background="#FF232631"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/tv_status_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#88FFFFFF"
            android:textSize="10sp"
            tools:text="12 items" />

        <View
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginHorizontal="8dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/tv_status_selected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            tools:text="No selection" />

        <TextView
            android:id="@+id/tv_status_free"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            tools:text="Free: 24.5 GB" />
    </LinearLayout>

</LinearLayout>
