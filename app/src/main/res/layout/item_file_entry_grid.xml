<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_file_grid_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_win_btn"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/img_file_grid_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        tools:src="@drawable/ic_folder" />

    <TextView
        android:id="@+id/tv_file_grid_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="middle"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="#FFFFFF"
        android:textSize="11.5sp"
        tools:text="Document.pdf" />

    <TextView
        android:id="@+id/tv_file_grid_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#9AA0A6"
        android:textSize="9.5sp"
        tools:text="2.4 MB" />
</LinearLayout>
