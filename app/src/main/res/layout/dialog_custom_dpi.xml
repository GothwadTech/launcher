<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Custom App DPI"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:text="Adjust the display density for Gothwad Launcher. Lower DPI makes elements smaller with more space, higher DPI makes elements larger."
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <!-- Device Default DPI info banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Device Hardware Default"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_dialog_device_dpi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="320 DPI"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Custom DPI number input & Stepper Controls -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter DPI Value (120 - 720)"
        android:textAllCaps="true"
        android:textColor="#4DD0E1"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btn_dpi_step_minus_20"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_dialog_button"
            android:text="-20"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_dpi_step_minus_5"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_dialog_button"
            android:text="-5"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_custom_dpi_number"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_card"
            android:gravity="center"
            android:hint="320"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_dpi_step_plus_5"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_dialog_button"
            android:text="+5"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_dpi_step_plus_20"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_dialog_button"
            android:text="+20"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Quick Presets -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Presets"
        android:textAllCaps="true"
        android:textColor="#64748B"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_preset_240"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_button"
            android:text="240"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_preset_280"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_button"
            android:text="280"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_preset_320"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_button"
            android:text="320"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_preset_400"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_button"
            android:text="400"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_preset_480"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_button"
            android:text="480"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Buttons: Reset, Cancel, Apply -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_dialog_reset_dpi"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_button"
            android:paddingHorizontal="14dp"
            android:text="Reset to Device"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_dialog_cancel_dpi"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_button"
            android:paddingHorizontal="14dp"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_dialog_apply_dpi"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_dialog_button"
            android:paddingHorizontal="18dp"
            android:text="Apply DPI"
            android:textColor="#4DD0E1"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
