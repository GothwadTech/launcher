<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_dialog_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Install Web App"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Run any website as a standalone desktop app"
                android:textColor="#99FFFFFF"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_dialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_win_btn"
            android:contentDescription="Close"
            android:padding="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="#26FFFFFF" />

    <!-- Web App URL Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Web App Link (URL)"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pc_taskbar_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <EditText
            android:id="@+id/et_webapp_url"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="https://web.telegram.org"
            android:imeOptions="actionNext"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textColorHint="#55FFFFFF"
            android:textSize="12.5sp" />

        <Button
            android:id="@+id/btn_autofetch"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pc_taskbar_btn"
            android:paddingHorizontal="10dp"
            android:text="Auto Fetch"
            android:textAllCaps="false"
            android:textColor="#4FA7FA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- App Name Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="App Name"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pc_taskbar_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <EditText
            android:id="@+id/et_webapp_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="e.g. Telegram Web"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textColorHint="#55FFFFFF"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- App Icon Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="App Logo / Icon (Optional or Auto-Fetched)"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Icon Preview Squircle -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_pc_taskbar_btn">

            <ImageView
                android:id="@+id/img_icon_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Icon Preview"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/progress_fetching_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_pick_custom_logo"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:paddingHorizontal="12dp"
                android:text="Choose Custom Logo..."
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tv_icon_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Will automatically fetch website favicon"
                android:textColor="#77FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Presets -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Quick Presets"
        android:textColor="#88FFFFFF"
        android:textSize="10.5sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/preset_telegram"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:paddingHorizontal="10dp"
                android:text="Telegram"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/preset_whatsapp"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:paddingHorizontal="10dp"
                android:text="WhatsApp"
                android:textAllCaps="false"
                android:textColor="#4ADE80"
                android:textSize="11sp" />

            <Button
                android:id="@+id/preset_twitter"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:paddingHorizontal="10dp"
                android:text="X / Twitter"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/preset_github"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:paddingHorizontal="10dp"
                android:text="GitHub"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/preset_chatgpt"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pc_taskbar_btn"
                android:paddingHorizontal="10dp"
                android:text="ChatGPT"
                android:textAllCaps="false"
                android:textColor="#10B981"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_taskbar_btn"
            android:paddingHorizontal="16dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_install_web_app"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_primary_blue_btn"
            android:paddingHorizontal="20dp"
            android:text="Install to Desktop"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
