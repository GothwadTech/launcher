<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/window_root"
    android:layout_width="420dp"
    android:layout_height="300dp"
    android:elevation="12dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="#F2191E2A"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Title Bar - Draggable -->
        <RelativeLayout
            android:id="@+id/window_titlebar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/bg_pc_window_titlebar"
            android:paddingStart="8dp"
            android:paddingEnd="2dp">

            <!-- App Icon + Title -->
            <LinearLayout
                android:id="@+id/layout_title_info"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/layout_window_controls"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_window_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tv_window_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="YouTube" />

                <TextView
                    android:id="@+id/tv_window_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#22FFFFFF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Running"
                    android:textColor="#99FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Window Controls: Minimize, Maximize, Close -->
            <LinearLayout
                android:id="@+id/layout_window_controls"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Minimize -->
                <FrameLayout
                    android:id="@+id/btn_window_minimize"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_pc_window_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/img_minimize"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:contentDescription="Minimize" />
                </FrameLayout>

                <!-- Maximize / Restore -->
                <FrameLayout
                    android:id="@+id/btn_window_maximize"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_pc_window_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/img_maximize"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:contentDescription="Maximize" />
                </FrameLayout>

                <!-- Close -->
                <FrameLayout
                    android:id="@+id/btn_window_close"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_pc_window_btn_close"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/img_close"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:contentDescription="Close" />
                </FrameLayout>
            </LinearLayout>

            <!-- Bottom border -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentBottom="true"
                android:background="#14FFFFFF" />
        </RelativeLayout>

        <!-- Window Content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Content Area -->
            <LinearLayout
                android:id="@+id/window_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0DFFFFFF"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/img_content_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:elevation="2dp" />

                <TextView
                    android:id="@+id/tv_content_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="YouTube" />

                <TextView
                    android:id="@+id/tv_content_pkg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp"
                    tools:text="com.google.android.youtube" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#22FFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_content_open"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_dialog_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:text="Open Fullscreen"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_content_info"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pc_taskbar_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="App Info"
                        android:textColor="#CCCCCC"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:alpha="0.5"
                    android:gravity="center"
                    android:text="💡 Tip: On Android 12L+ / DeX devices,\nthis will open in real freeform window"
                    android:textColor="#88FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Resize Handle (Bottom Right) -->
            <View
                android:id="@+id/view_resize_handle"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:background="#22FFFFFF"
                android:clickable="true" />

            <ImageView
                android:id="@+id/img_resize_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="4dp"
                android:alpha="0.4"
                android:contentDescription="Resize" />
        </FrameLayout>

        <!-- Focus Border Overlay -->
        <View
            android:id="@+id/view_focus_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pc_window"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
