<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="132dp"
    android:layout_height="92dp"
    android:background="@drawable/bg_settings_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="62dp">

        <!-- Gradient thumbnail, drawable built in code from the preset it represents -->
        <View
            android:id="@+id/tile_gradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:background="#13547A" />

        <!-- Selected marker: filled cyan check badge, top-end -->
        <TextView
            android:id="@+id/tile_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_check_badge_cyan"
            android:gravity="center"
            android:text="✓"
            android:textColor="#111215"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/tile_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/color_settings_btn_text"
        android:textSize="11sp"
        tools:text="Aurora" />
</LinearLayout>
