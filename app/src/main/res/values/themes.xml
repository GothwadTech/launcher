<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LiteTV" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand Colors from Theme.kt -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue</item>
        <item name="colorOnPrimary">@android:color/black</item>
        
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:colorBackground">@android:color/black</item>

        <!-- System Bar Colors -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Bottom Sheet Theme -->
        <item name="bottomSheetDialogTheme">@style/Theme.LiteTV.BottomSheetDialog</item>
        <item name="dialogTheme">@style/Theme.LiteTV.Dialog</item>
    </style>

    <style name="Theme.LiteTV.BottomSheetDialog" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.LiteTV.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.LiteTV.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
