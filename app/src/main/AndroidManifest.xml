<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV and Mobile: leanback optional so mobile/tablet can install it too -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <!-- A launcher must see every launchable app -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Enhanced Launcher Permissions -->
    <!-- 1. Usage stats for Most Used / Frequently Used Apps -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- NOTE: no RECORD_AUDIO permission is required. Voice search is delegated to the
         system recognizer via RecognizerIntent (ACTION_RECOGNIZE_SPEECH), which records
         the audio in its own process and returns text to us. -->
    <!-- 4. Bluetooth for Remote & Gamepad Battery info -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 5. Kept on purpose: fail-safe layer for the global App Lock overlay. The primary
         path is TYPE_ACCESSIBILITY_OVERLAY (no permission needed); this permission only
         matters on firmware where that window type is refused, so a locked app can still
         be covered instead of being revealed. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- NOTE: no storage permissions are required. Wallpapers are picked through the
         Storage Access Framework (ActivityResultContracts.OpenDocument), which grants
         per-file access without READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE. -->
    <!-- 7. Boot completed to launch on TV start and guard against OEM boot ads -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".GothwadApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/app_icon"
        android:roundIcon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.LiteTV"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|density|uiMode">

            <!-- Home-screen replacement -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Visible in the stock TV launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Visible on phone/tablet launchers too (handy for testing) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Accessibility Service to override Home button on locked Android TV / Google TV -->
        <service
            android:name=".service.LauncherAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/accessibility_service_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Notification Listener Service to show incoming notifications on TV -->
        <service
            android:name=".service.TvNotificationListenerService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:label="@string/notification_service_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Ultra-lightweight crash & ANR self-healing watchdog running in isolated process -->
        <!-- directBootAware: the watchdog is started from BOOT_COMPLETED, which on
             encrypted devices can be delivered as LOCKED_BOOT_COMPLETED before the
             credential-encrypted storage is mounted. Without this flag any component
             started from that receiver throws (issue #26). All of our file-backed state
             (heartbeat, relaunch budget) is wrapped in runCatching, so pre-unlock it is
             simply unavailable instead of fatal. -->
        <service
            android:name=".service.LauncherWatchdogService"
            android:process=":watchdog"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Boot-ad / stock-launcher shield. Runs here (not inside the receiver) because
             the guard window is 45-90 seconds, far beyond the broadcast execution limit. -->
        <service
            android:name=".service.BootShieldService"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Boot Receiver for TV Boot Auto-Start & OEM Boot Ad Shield -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
